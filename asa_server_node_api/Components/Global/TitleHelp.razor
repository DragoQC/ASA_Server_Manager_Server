@using asa_server_node_api.Services
<div class="flex flex-wrap items-center gap-3">
	<div class="relative inline-block pr-8">
		<h2 class="@TitleClass">@Title</h2>
		<button type="button" @onclick="OpenDialog"
						class="absolute right-0 top-0 inline-flex h-5 w-5 shrink-0 -translate-y-1/4 items-center justify-center rounded-full border border-cyan-300/30 bg-cyan-400/15 text-[0.7rem] font-semibold text-cyan-100 shadow-[0_0_18px_rgba(34,211,238,0.3)] transition hover:bg-cyan-400/25"
						aria-label="@($"{Title} help")">
			?
		</button>
	</div>

	@if (ChildContent is not null)
	{
		@ChildContent
	}
</div>

@code {
	[Inject]
	public HelpDialogService HelpDialogService { get; set; } = default!;

	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	[Parameter]
	public string? Description { get; set; }

	[Parameter]
	public string TitleClass { get; set; } = "text-3xl font-semibold text-white";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public RenderFragment? DescriptionContent { get; set; }

	private Task OpenDialog()
	{
		HelpDialogService.Show(Title, Description, DescriptionContent);
		return Task.CompletedTask;
	}
}
